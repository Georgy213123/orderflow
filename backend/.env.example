# Скопируйте в .env при необходимости. Значения фиктивные.
DATABASE_URL=postgresql+psycopg://postgres@localhost:55301/orderflow
# rules — правила и регулярные выражения (по умолчанию), llm — адаптер к модели (заглушка)
