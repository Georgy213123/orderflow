      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Answer_di" bpmnElement="Task_Answer">
        <dc:Bounds x="1120" y="75" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Parsed_di" bpmnElement="Task_Parsed">
        <dc:Bounds x="1120" y="355" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Params_di" bpmnElement="Task_Params">
        <dc:Bounds x="1285" y="495" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Spec_di" bpmnElement="Task_Spec">
        <dc:Bounds x="1450" y="355" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Valid_di" bpmnElement="Gw_Valid" isMarkerVisible="true">
        <dc:Bounds x="1650" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1620" y="419" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Estimate_di" bpmnElement="Task_Estimate">
        <dc:Bounds x="1780" y="355" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Complete_di" bpmnElement="Gw_Complete" isMarkerVisible="true">
        <dc:Bounds x="1980" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1950" y="419" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Price_di" bpmnElement="Task_Price">
        <dc:Bounds x="2110" y="635" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Send_di" bpmnElement="Task_Send">
        <dc:Bounds x="2110" y="215" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Receive_di" bpmnElement="Task_Receive">
        <dc:Bounds x="2275" y="75" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Got_di" bpmnElement="End_Got">
        <dc:Bounds x="2482" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2452" y="132" width="96" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="110" />
        <di:waypoint x="295" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="355" y="145" />
        <di:waypoint x="355" y="250" />
        <di:waypoint x="460" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="520" y="285" />
        <di:waypoint x="520" y="390" />
        <di:waypoint x="625" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="685" y="355" />
        <di:waypoint x="685" y="250" />
        <di:waypoint x="790" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="910" y="250" />
        <di:waypoint x="990" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1015" y="225" />
        <di:waypoint x="1015" y="110" />
        <di:waypoint x="1120" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1021" y="205" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1180" y="145" />
        <di:waypoint x="1180" y="194" />
        <di:waypoint x="850" y="194" />
        <di:waypoint x="850" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1015" y="275" />
