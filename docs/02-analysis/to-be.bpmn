        <di:waypoint x="1345" y="474" />
        <di:waypoint x="1345" y="495" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1681" y="395" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
