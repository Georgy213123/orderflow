        <di:waypoint x="1120" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1021" y="255" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1180" y="425" />
        <di:waypoint x="1180" y="530" />
        <di:waypoint x="1285" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
